<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:property name="lidar_radius" value="0.027"/>
  <xacro:property name="lidar_height" value="0.0313"/>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
      <mass value="0.07"/>
      <inertia ixx="${(0.07/12) * (3*lidar_radius*lidar_radius + lidar_height*lidar_height)}"
               ixy="0.0"
               ixz="0.0"
               iyy="${(0.07/12) * (3*lidar_radius*lidar_radius + lidar_height*lidar_height)}"
               iyz="0.0"
               izz="${(0.07/2) * lidar_radius*lidar_radius}"/>
    </inertial>

    <visual name="lidar_link_visual">
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://omni_manipulator_description/meshes/visual/ld19.STL"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision name="lidar_link_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 0.071" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/scan_raw</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>450</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.283185</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
</robot>
