<?xml version="1.0" encoding="utf-8"?>
<robot
  name="omni_manipulator_description" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  
  <link name="base_link">
    <inertial>
      <origin
        xyz="-0.00901312318197482 7.81757376177895E-05 0.0445423970884756"
        rpy="0 0 0" />
      <mass
        value="0.527041850411029" />
      <inertia
        ixx="0.000864581380625486"
        ixy="4.97642778210476E-07"
        ixz="1.54819622657063E-08"
        iyy="0.00161630877736204"
        iyz="-8.23724472378619E-09"
        izz="0.00177052599006481" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://omni_manipulator_description/meshes/visual/base_link.STL" />
      </geometry>
      <material name="">
        <color
          rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="-0.0065 0 0.045"
        rpy="0 0 0" />
      <geometry>
        <box size="0.20 0.20 0.09"/>
      </geometry>
    </collision>
  </link>

  <link name="front_left_wheel_link">
    <inertial>
      <origin
        xyz="-4.5209E-06 -0.020971 -4.8866E-05"
        rpy="0 0 0" />
      <mass
        value="0.1238" />
      <inertia
        ixx="2.3671E-05"
        ixy="2.3772E-12"
        ixz="5.4728E-11"
        iyy="3.1205E-05"
        iyz="-5.9358E-13"
        izz="2.3671E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://omni_manipulator_description/meshes/visual/front_left_wheel_link.STL" />
      </geometry>
      <material name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.042"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="front_left_wheel_joint"
    type="continuous">
    <origin
      xyz="0.074941 0.12088 -0.037794"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="front_left_wheel_link" />
    <axis
      xyz="0 1 0" />
  </joint>

  <link name="front_right_wheel_link">
    <inertial>
      <origin
        xyz="-4.4854E-05 0.020971 1.9913E-05"
        rpy="0 0 0" />
      <mass
        value="0.1238" />
      <inertia
        ixx="2.3671E-05"
        ixy="-7.1009E-13"
        ixz="-1.524E-10"
        iyy="3.1205E-05"
        iyz="-2.3757E-12"
        izz="2.3671E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://omni_manipulator_description/meshes/visual/front_right_wheel_link.STL" />
      </geometry>
      <material name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.042"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="front_right_wheel_joint"
    type="continuous">
    <origin
      xyz="0.074874 -0.12088 -0.037679"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="front_right_wheel_link" />
    <axis
      xyz="0 1 0" />
  </joint>

  <link name="rear_right_wheel_link">
    <inertial>
      <origin
        xyz="-3.1993E-05 0.020971 3.7213E-05"
        rpy="0 0 0" />
      <mass
        value="0.1238" />
      <inertia
        ixx="2.3671E-05"
        ixy="-1.6153E-12"
        ixz="-2.1865E-10"
        iyy="3.1205E-05"
        iyz="-1.8749E-12"
        izz="2.3671E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://omni_manipulator_description/meshes/visual/rear_right_wheel_link.STL" />
      </geometry>
      <material name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.042"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="rear_right_wheel_joint"
    type="continuous">
    <origin
      xyz="-0.088234 -0.12088 -0.037681"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="rear_right_wheel_link" />
    <axis
      xyz="0 1 0" />
  </joint>

  <link name="rear_left_wheel_link">
    <inertial>
      <origin
        xyz="-3.3869E-07 -0.020971 -4.9074E-05"
        rpy="0 0 0" />
      <mass
        value="0.1238" />
      <inertia
        ixx="2.3671E-05"
        ixy="2.432E-12"
        ixz="1.7836E-11"
        iyy="3.1205E-05"
        iyz="-3.8664E-13"
        izz="2.3671E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://omni_manipulator_description/meshes/visual/rear_left_wheel_link.STL" />
      </geometry>
      <material name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.042"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="rear_left_wheel_joint"
    type="continuous">
    <origin
      xyz="-0.088195 0.12088 -0.037789"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="rear_left_wheel_link" />
    <axis
      xyz="0 1 0" />
  </joint>

  <!-- Mecanum wheel friction model -->
  <gazebo reference='front_left_wheel_link'>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference='front_right_wheel_link'>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference='rear_left_wheel_link'>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference='rear_right_wheel_link'>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ROS2 Control hardware interface -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ROS2 Control plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find omni_manipulator_description)/config/mecanum_drive_controller.yaml</parameters>
      <ros>
        <remapping>/mecanum_drive_controller/reference:=/cmd_vel</remapping>
        <remapping>/mecanum_drive_controller/odom:=/odom</remapping>
      </ros>
    </plugin>
  </gazebo>

</robot>