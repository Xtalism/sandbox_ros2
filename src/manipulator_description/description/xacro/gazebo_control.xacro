<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone-arm control wiring: the ros2_control block plus this
     package's own gz_ros2_control plugin/controller file. When the arm is
     mounted on another robot, include manipulator_ros2_control.xacro
     directly instead - that robot declares the plugin itself. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:include filename="$(find manipulator_description)/description/xacro/manipulator_ros2_control.xacro" />

  <xacro:manipulator_ros2_control name="RobotSystem" prefix=""
    initial_positions_file="$(find manipulator_description)/config/initial_positions.yaml"/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find manipulator_description)/config/manipulator_controller.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
