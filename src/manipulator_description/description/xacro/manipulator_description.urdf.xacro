<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone arm: the manipulator macro anchored to a fixed world link.
     Link/joint names are unprefixed here, which is what
     manipulator_moveit_config's SRDF expects. -->
<robot name="manipulator_description" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:include filename="$(find manipulator_description)/description/xacro/manipulator_macro.xacro" />
  <xacro:include filename="$(find manipulator_description)/description/xacro/gazebo_control.xacro" />

  <link name="world"/>

  <xacro:manipulator prefix="" parent="world" joint_name="virtual_joint">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:manipulator>

</robot>
