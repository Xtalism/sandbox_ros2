<?xml version="1.0" encoding="utf-8"?>
<!-- Description-only definition of the 5-DOF arm, with no ros2_control or
     gazebo plugin wiring, so it can be dropped onto another robot's link
     (see omni_manipulator_description) as well as stand alone.

     Every link and joint is prefixed, because the arm's own "base_link"
     collides with the name of the mobile base's root link when the two
     descriptions are combined. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:property name="PI" value="3.14159265359" />

  <xacro:macro name="manipulator_transmission" params="name">
    <transmission name="${name}_transmission">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="${name}_actuator" role="actuator_1"/>
      <joint name="${name}" role="joint_1">
        <mechanical_reduction>1.0</mechanical_reduction>
      </joint>
    </transmission>
  </xacro:macro>

  <!-- prefix     : prepended to every link and joint name ("" when standalone)
       parent     : link the arm is bolted to
       joint_name : name of the fixed joint from parent to the arm's base link
       *origin    : pose of the arm's base link in the parent frame -->
  <xacro:macro name="manipulator" params="prefix:='' parent:='world' joint_name:='virtual_joint' *origin">

    <joint name="${joint_name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link
      name="${prefix}base_link">
      <inertial>
        <origin
          xyz="-0.00125935649399742 -0.000470828682098662 0.0242757991162855"
          rpy="0 0 0" />
        <mass
          value="0.0382070631949755" />
        <inertia
          ixx="1.06084491676467E-05"
          ixy="-3.26790900389718E-10"
          ixz="1.55715035338171E-07"
          iyy="6.05895904112999E-06"
          iyz="1.70232643106764E-08"
          izz="7.32724940736576E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/base_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/base_link.STL" />
        </geometry>
      </collision>
    </link>
    <link
      name="${prefix}link_1">
      <inertial>
        <origin
          xyz="-0.000352632925941452 -0.0122755959836562 0.011761084859218"
          rpy="0 0 0" />
        <mass
          value="0.0382070631949755" />
        <inertia
          ixx="6.05895904112999E-06"
          ixy="-1.39083232081176E-08"
          ixz="3.26790900394249E-10"
          iyy="7.32724940736578E-06"
          iyz="-1.5571391727732E-07"
          izz="1.06084491676467E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_1.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_1.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}joint_1"
      type="revolute">
      <origin
        xyz="-0.00013003 -0.010042 0.0523"
        rpy="0 0 0" />
      <parent
        link="${prefix}base_link" />
      <child
        link="${prefix}link_1" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-${PI/2}"
        upper="${PI/2}"
        effort="10"
        velocity="3.0" />
    </joint>
    <link
      name="${prefix}link_2">
      <inertial>
        <origin
          xyz="0.051993515342474 -9.31322574615479E-10 -0.0267906665296395"
          rpy="0 0 0" />
        <mass
          value="0.0170251169263653" />
        <inertia
          ixx="1.08907010787335E-05"
          ixy="-3.11047077368203E-08"
          ixz="-5.69079581921169E-21"
          iyy="1.68733569095532E-05"
          iyz="4.92221335979852E-21"
          izz="7.85969468178104E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_2.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_2.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}joint_2"
      type="revolute">
      <origin
        xyz="-0.0099229 -0.0403 0.01289"
        rpy="1.5708 0 0" />
      <parent
        link="${prefix}link_1" />
      <child
        link="${prefix}link_2" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-0.18"
        upper="${PI/2}"
        effort="10"
        velocity="3.0" />
    </joint>
    <link
      name="${prefix}link_3">
      <inertial>
        <origin
          xyz="0.0207872542879387 -0.00129222747215796 -0.0276277319990221"
          rpy="0 0 0" />
        <mass
          value="0.0494773487894259" />
        <inertia
          ixx="1.18336660189981E-05"
          ixy="-1.24373046667245E-07"
          ixz="1.22838258168432E-08"
          iyy="1.954406916305E-05"
          iyz="1.55736259696696E-07"
          izz="1.17899796886126E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_3.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_3.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}joint_3"
      type="revolute">
      <origin
        xyz="0.10399 0 -0.0536"
        rpy="3.1416 0 1.5708" />
      <parent
        link="${prefix}link_2" />
      <child
        link="${prefix}link_3" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-0.9"
        upper="${PI/2}"
        effort="10"
        velocity="3.0" />
    </joint>
    <link
      name="${prefix}link_4">
      <inertial>
        <origin
          xyz="0.0195473572227962 0.00989478222104906 -0.0286687556334632"
          rpy="0 0 0" />
        <mass
          value="0.0764141263985193" />
        <inertia
          ixx="1.7935698575237E-05"
          ixy="1.54155242457294E-07"
          ixz="-1.79704895792915E-07"
          iyy="1.66481799207673E-05"
          iyz="-2.81234507419311E-07"
          izz="1.34054367385943E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_4.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_4.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}joint_4"
      type="revolute">
      <origin
        xyz="0.096947 0.00052331 -0.053071"
        rpy="3.1416 0 1.5708" />
      <parent
        link="${prefix}link_3" />
      <child
        link="${prefix}link_4" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-0.7"
        upper="${PI/2}"
        effort="10"
        velocity="3.0" />
    </joint>
    <link
      name="${prefix}link_5">
      <inertial>
        <origin
          xyz="-0.000538856928884224 -0.000263120239408951 0.0569395076569807"
          rpy="0 0 0" />
        <mass
          value="0.0268863153129433" />
        <inertia
          ixx="7.16101855054134E-06"
          ixy="-1.13902756733897E-07"
          ixz="4.51408091744934E-09"
          iyy="5.41815544607678E-06"
          iyz="6.93651865535309E-08"
          izz="1.95010952728468E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_5.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://manipulator_description/meshes/visual/link_5.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}joint_5"
      type="revolute">
      <origin
        xyz="0.06599 0.011967 -0.019837"
        rpy="-1.5708 0 -1.5708" />
      <parent
        link="${prefix}link_4" />
      <child
        link="${prefix}link_5" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-${PI/2}"
        upper="${PI/2}"
        effort="10"
        velocity="3.0" />
    </joint>

    <xacro:manipulator_transmission name="${prefix}joint_1"/>
    <xacro:manipulator_transmission name="${prefix}joint_2"/>
    <xacro:manipulator_transmission name="${prefix}joint_3"/>
    <xacro:manipulator_transmission name="${prefix}joint_4"/>
    <xacro:manipulator_transmission name="${prefix}joint_5"/>

  </xacro:macro>

</robot>
