<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <link name="depth_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.130 0.022"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.130 0.022"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.035"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="depth_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_link"/>
    <origin xyz="0.20 0 0.12" rpy="0 0 0"/>
  </joint>

  <gazebo reference="depth_link">
    <!-- type="depth_camera", not the bundled rgbd_camera: nav2's costmap
         only consumes /camera/points, so the RGB image render was pure
         unused overhead. rgbd_camera at 640x480@10Hz measured as the
         direct cause of severe /clock jitter (4343 "jump back in time"
         events/min vs 14 with no camera at all, confirmed by A/B test);
         320x240@5Hz cut that to 1171 but didn't fully resolve it - this
         drops the RGB render pass entirely as a further, structural cut
         rather than continuing to tune resolution/rate parameters. -->
    <sensor name="camera" type="depth_camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>5.0</update_rate>
      <topic>/camera</topic>
      <!-- Tried relabeling this to a separately-rotated optical child
           frame (standard for real hardware, e.g. d435.xacro's
           depth_optical_frame) - broke the geometry: gz-sim's simulated
           depth_camera apparently already emits data correctly relative
           to this link's own pose, so adding a second rotation on top
           via TF double-rotated it (visually: obstacles appeared behind
           the robot while it was actually facing them). Reverted. -->
      <gz_frame_id>depth_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047198</horizontal_fov>
        <!-- gz-sim's depth_camera outputs one point per pixel (inf for
             no-return), not a filtered/sparse obstacle list - even
             320x240 meant nav2's voxel layer processed 76800 points
             every cycle, ~170x what the 450-point lidar scan costs it.
             80x60 cuts that to 4800 - still enough for costmap-grade
             obstacle detection, not for anything image-quality. -->
        <image>
          <width>80</width>
          <height>60</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
