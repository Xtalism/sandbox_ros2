<?xml version="1.0" encoding="utf-8"?>
<robot name="mecanum_description" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  <xacro:include filename="robot_base.xacro"/>
  <xacro:include filename="wheels.xacro"/>
  <xacro:include filename="gazebo_control.xacro"/>
  <xacro:include filename="imu.xacro"/>
  <xacro:include filename="lidar.xacro"/>
  <xacro:include filename="depth_sensor.xacro"/>

  <xacro:mecanum_wheel_friction/>
  <xacro:mecanum_ros2_control name="GazeboSimSystem"/>

  <!-- Gazebo ROS2 Control plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find mecanum_description)/config/mecanum_drive_controller.yaml</parameters>
      <ros>
        <remapping>/mecanum_drive_controller/reference:=/cmd_vel</remapping>
        <remapping>/mecanum_drive_controller/odometry:=/wheel_odom</remapping>
      </ros>
    </plugin>
  </gazebo>
</robot>
